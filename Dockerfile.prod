# 生产部署：使用 Mac 上已 build 的 dist / dist-server，不在服务器编译
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3080
ENV DATABASE_PATH=/app/data/app.db
COPY package.json package-lock.json* ./
RUN npm install --omit=dev
COPY dist ./dist
COPY dist-server ./dist-server
COPY public ./public
COPY server/merchantForm/fill.py server/merchantForm/template.pdf ./server/merchantForm/
COPY server/merchantForm/fonts ./server/merchantForm/fonts
# 服务器在腾讯云，默认 Alpine/PyPI 源经常卡住。走腾讯云镜像。
# PyMuPDF 2.0 没有 musllinux 轮子，Alpine 会去编译源码。固定已验证的 1.28.2。
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.cloud.tencent.com#g' /etc/apk/repositories \
 && apk add --no-cache python3 py3-pip \
 && pip3 install --break-system-packages --no-cache-dir \
      -i https://mirrors.cloud.tencent.com/pypi/simple \
      --trusted-host mirrors.cloud.tencent.com \
      'PyMuPDF==1.28.2' 'fonttools>=4.50' \
 && mkdir -p /app/data
EXPOSE 3080
CMD ["sh", "-c", "node dist-server/seed.js 2>/dev/null || true; node dist-server/index.js"]
